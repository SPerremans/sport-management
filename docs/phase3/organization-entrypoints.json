    "name": "VAL_Federation_BillingMethod",
    "folder": "CRM/Federations",
    "params": [
      [
        "Federation",
        "MyFirstModule.Federation"
      ]
    ],
    "returnType": "Boolean",
    "steps": [
      {
        "end": "$Federation/BillingMethod = 'ACTIVE_AT_CENSUS' or $Federation/BillingMethod = 'UNIQUE_DURING_YEAR' or $Federation/BillingMethod = 'PRORATA_ACTIVE_DAYS'"
      }
    ]
