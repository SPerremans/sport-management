  {
    "name": "BCO_RegistrationRequest_ValidateFinance",
    "folder": "CRM/Registration",
    "entity": "RegistrationRequest",
    "parameter": "Request",
    "params": [
      [
        "Request",
        "MyFirstModule.RegistrationRequest"
      ]
    ],
    "returnType": "Boolean",
    "steps": [
      {
        "end": "$Request/RequestedInstallments >= 1 and $Request/RequestedInstallments <= 12 and $Request/ApprovedInstallments >= 1 and $Request/ApprovedInstallments <= $Request/RequestedInstallments and ($Request/InstalmentStatus = 'NotRequested' or $Request/InstalmentStatus = 'Pending' or $Request/InstalmentStatus = 'Approved' or $Request/InstalmentStatus = 'Rejected')"
      }
    ]
  },
